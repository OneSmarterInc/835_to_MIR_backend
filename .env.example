# Django core settings
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=api.yourdomain.com,localhost

# CORS & CSRF (set to your Vercel frontend URL in production)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Cross-origin cookie settings (required when frontend is on a different domain)
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Database
DATABASE_URL=postgres://project835_user:your_secure_password@localhost:5432/project835


# SMTP credential encryption key
SMTP_FIELD_ENCRYPTION_KEY=
