# Django Core Security Settings
DEBUG=False
SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=mir.onesmarter.com,api.onesmarter.com,localhost,127.0.0.1

# CORS & CSRF Origins (set to your production frontend domain)
CORS_ALLOWED_ORIGINS=https://filex.onesmarter.com,https://mir.onesmarter.com
CSRF_TRUSTED_ORIGINS=https://filex.onesmarter.com,https://mir.onesmarter.com

# Cross-Origin Cookie Settings
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
SESSION_COOKIE_AGE=3600

# Database Settings
DATABASE_URL=postgres://project835_user:your_secure_password@localhost:5432/project835

# Field Encryption Keys (for SMTP and SFTP credentials in DB)
SMTP_FIELD_ENCRYPTION_KEY=your-base64-fernet-key-here
SFTP_FIELD_ENCRYPTION_KEY=your-base64-fernet-key-here

# MPL Reconciliation Policy Defaults
MPL_RECON_MIR907_SOURCE=computed
MPL_RECON_MIR908_SOURCE=computed
MPL_RECON_INCLUDE_MPL920=true
MPL_RECON_WATERFALL_STEPS=MIR901,MIR907,MIR908,MPL920
