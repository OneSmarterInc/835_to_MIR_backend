{
  "openapi": "3.1.0",
  "info": {
    "title": "FileX Transfer API",
    "version": "1.1.0",
    "description": "202 confirms durable source, receipt, submission key and dispatch commit, not validation or processing. All timestamps are UTC. Partner identity survives credential rotation. mTLS is served only on the separately provisioned partner origin; internal gateway headers are never client API parameters."
  },
  "servers": [
    {
      "url": "https://mir.onesmarter.com"
    }
  ],
  "security": [
    {
      "partnerMTLS": []
    },
    {
      "partnerBearer": []
    },
    {
      "staffSession": []
    }
  ],
  "paths": {
    "/api/v1/transfers": {
      "post": {
        "operationId": "submitTransfer",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[!-~]+$"
            },
            "description": "Principal-scoped, independent of routing. Retain the same key across retries. Changed bytes/client/workflow return 409. Filename changes alone do not conflict. Keys remain for the retained receipt lifetime."
          },
          {
            "name": "X-CSRFToken",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Required on staff-session POSTs. Obtain csrf_token from GET /accounts/api/user/."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "workflow"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "workflow": {
                    "type": "string",
                    "enum": [
                      "835",
                      "837"
                    ]
                  },
                  "client_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Required for staff; partner client is credential-bound."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original receipt recovered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "202": {
            "description": "New durable receipt; includes linked content duplicates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Authenticated status URL"
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required; sign in before recovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden or CSRF/MFA required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No committed authorized resource visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict, unresolved same-key submission or unsafe retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 2
                },
                "description": "Returned for SUBMISSION_IN_PROGRESS; retry with the original key."
              }
            }
          },
          "413": {
            "description": "Upload size limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Outcome uncertain; recover with original key before replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTransfers",
        "description": "Staff see authorized clients across channels; partners see only their own permitted submissions. Order: received_at DESC, receipt_id DESC. New arrivals can shift offset pages.",
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "RECEIVED",
                "VALIDATING",
                "QUEUED",
                "PROCESSING",
                "COMPLETED",
                "REJECTED",
                "FAILED",
                "DUPLICATE"
              ]
            }
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "STAFF",
                "SFTP",
                "PARTNER",
                "ANALYSIS",
                "SYSTEM"
              ]
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive UTC date."
          },
          {
            "name": "date_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive UTC date."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "transfers",
                    "page",
                    "page_size",
                    "pages",
                    "total"
                  ],
                  "properties": {
                    "transfers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Receipt"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    },
                    "pages": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required; sign in before recovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden or CSRF/MFA required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No committed authorized resource visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict, unresolved same-key submission or unsafe retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 2
                },
                "description": "Returned for SUBMISSION_IN_PROGRESS; retry with the original key."
              }
            }
          },
          "413": {
            "description": "Upload size limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Outcome uncertain; recover with original key before replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers/recover": {
