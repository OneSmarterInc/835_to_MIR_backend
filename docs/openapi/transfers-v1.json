    "/api/v1/transfers/{receipt_id}/retry": {
      "post": {
        "operationId": "retryTransfer",
        "security": [
          {
            "staffSession": []
          }
        ],
        "parameters": [
          {
            "name": "receipt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRFToken",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Required on staff-session POSTs. Obtain csrf_token from GET /accounts/api/user/."
          }
        ],
        "description": "Staff-only, FAILED canonical INTAKE with one source, no running attempts, recorded effects or outputs, and valid authorization/capacity/attempt budget. Reason audited; next attempt linked to parent. Never resends uncertain delivery.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500,
                    "description": "Resolved operational issue; no PHI or secrets."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Retry durably queued",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Receipt"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "retry_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required; sign in before recovery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden or CSRF/MFA required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No committed authorized resource visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict, unresolved same-key submission or unsafe retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "example": 2
                },
                "description": "Returned for SUBMISSION_IN_PROGRESS; retry with the original key."
              }
            }
          },
          "413": {
            "description": "Upload size limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
