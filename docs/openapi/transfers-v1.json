                }
              }
            }
          },
          "503": {
            "description": "Outcome uncertain; recover with original key before replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "partnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Rotatable credential UUID.secret for TOKEN-mode partners only; stable partner UUID scopes receipt ownership and submission keys. HTTPS and explicit permissions required."
      },
      "staffSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "Active staff session, MFA and client permission. Staff POSTs also require X-CSRFToken."
      },
      "partnerMTLS": {
        "type": "mutualTLS",
        "description": "Approved leaf certificate on the dedicated partner TLS gateway. Stable partner/client/workflow/action permissions apply. No bearer or session fallback for mTLS identities."
      }
    },
    "schemas": {
      "Receipt": {
        "type": "object",
        "required": [
          "receipt_id",
          "status_url",
          "client_id",
          "state",
          "workflow",
          "channel",
          "received_at",
          "filename",
          "byte_count"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "format": "uuid"
          },
          "status_url": {
            "type": "string"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "VALIDATING",
              "QUEUED",
              "PROCESSING",
              "COMPLETED",
              "REJECTED",
              "FAILED",
              "DUPLICATE"
            ]
          },
          "lifecycle_state": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "STAFF",
              "SFTP",
              "PARTNER",
              "ANALYSIS",
              "SYSTEM"
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "byte_count": {
            "type": "integer",
            "format": "int64"
          },
          "canonical_receipt_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "reused": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Detail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Receipt"
          },
          {
            "type": "object",
            "properties": {
              "source_url": {
                "type": "string"
              },
              "validation_outcome": {
                "type": "string"
              },
              "safe_error_code": {
                "type": "string"
              },
              "converter_version": {
                "type": "string"
              },
              "transaction_set_count": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "retry_eligible": {
                "type": "boolean"
              },
              "retry_blocked_reason": {
                "type": "string"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "checksum": {
                      "type": "string"
                    },
                    "byte_count": {
                      "type": "integer"
                    },
                    "delivery_state": {
                      "type": "string"
                    },
                    "download_url": {
                      "type": "string"
                    }
                  }
                }
              },
              "attempts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "Newest 20: id, sequence, parent_id, state, UTC lease/start/finish timestamps, retry_reason, safe_error_code, converter_version."
                }
              },
              "retries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "Staff-only newest 20: id, reason, actor_reference, parent_id, attempt_id, created_at."
                }
              },
              "transaction_sets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "First 100: id, sequence, transaction_type, control_number, version, first_segment, last_segment."
                }
              }
            }
          }
        ]
      }
    }
  }
}
