[Unit]
Description=Private Qwen3 0.6B MPL CPU Inference Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mir-ai/llama.cpp
EnvironmentFile=/etc/mpl-ai-server.env
ExecStart=/opt/mir-ai/llama.cpp/build/bin/llama-server --model /opt/mir-ai/models/Qwen3-0.6B-Q4_K_M.gguf --alias qwen3-0.6b-instruct-q4_k_m --host 127.0.0.1 --port 8080 --ctx-size 2048 --threads 1 --threads-batch 1 --parallel 1 --batch-size 128 --ubatch-size 64 --no-warmup --api-key ${MPL_AI_API_KEY}
Restart=always
RestartSec=5
TimeoutStartSec=900
Nice=10
CPUQuota=80%
MemoryHigh=1400M
MemoryMax=1700M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
