[Unit]
Description=Private Ministral 3 3B MPL Inference Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/mir-ai/llama.cpp
EnvironmentFile=/etc/mpl-ai-server.env
ExecStart=/opt/mir-ai/llama.cpp/build/bin/llama-server -hf mistralai/Ministral-3-3B-Instruct-2512-GGUF:Q4_K_M --host 0.0.0.0 --port 8080 --ctx-size 8192 --n-gpu-layers 99 --parallel 1 --api-key ${MPL_AI_API_KEY}
Restart=always
RestartSec=5
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
